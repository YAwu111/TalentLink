# 复制为 .env 后按需修改；未被本文件覆盖的项使用 app/core/config.py 中的默认值
DEBUG=true

# 数据库：默认 SQLite（零配置，直接跑）
DATABASE_URL=sqlite:///./talentlink.db
# 切换到 MySQL 时替换为下面这行（先建库：CREATE DATABASE talentlink DEFAULT CHARSET utf8mb4;）
# DATABASE_URL=mysql+pymysql://root:your_password@127.0.0.1:3306/talentlink?charset=utf8mb4

# JWT：生产环境务必换成长随机串
JWT_SECRET=talentlink-dev-secret-change-me-0123456789abcdef
JWT_ISSUER=talentlink
JWT_AUDIENCE=talentlink-web
ACCESS_TOKEN_EXPIRE_MINUTES=1
REFRESH_TOKEN_EXPIRE_DAYS=7

# 生产环境走 HTTPS 时置 true
COOKIE_SECURE=false

# 文件上传目录（相对 backend 工作目录）
UPLOAD_DIR=uploads

# 日志
LOG_LEVEL=INFO
LOG_DIR=logs
LOG_TO_FILE=true
LOG_BACKUP_DAYS=14

# 初始化数据
ADMIN_USERNAME=yawu1122345
ADMIN_PASSWORD=dev123123
SEED_DEMO=true
