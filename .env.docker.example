# 复制为 .env 后按需修改；不要提交真实密码
# cp .env.docker.example .env
# docker compose up -d --build

# 对外访问端口，默认 http://localhost:8080
WEB_PORT=8080

# 首次启动是否写入演示求职者/企业/岗位数据
SEED_DEMO=true

# 必须修改：JWT 签名密钥和初始管理员密码
JWT_SECRET=change-me-to-a-long-random-secret-at-least-32-bytes
ADMIN_USERNAME=yawu1122345
ADMIN_PASSWORD=change-me-admin-password

# HTTP 本地部署保持 false；HTTPS 部署必须改为 true
COOKIE_SECURE=false
COOKIE_SAMESITE=lax

# local = 本地 OCR + 规则；mock = 固定识别结果
RECOGNITION_PROVIDER=local
